# Reddit Lead Intelligence Platform — Environment Variables
# ─────────────────────────────────────────────────────────────
# For Railway: set these in the Variables tab (not in a file)
# They survive redeploys — unlike monitor_config.json which resets.

# Server port (Railway sets this automatically — set to 3000 in Railway Variables)
PORT=3000

# URL prefix when behind a reverse proxy
# Leave empty for Railway: BASE_PATH=
# Set to /monitor for Replit: BASE_PATH=/monitor
BASE_PATH=

# Telegram bot credentials — set these in Railway Variables tab
# Getting them:
#   TELEGRAM_BOT_TOKEN → message @BotFather on Telegram, send /newbot
#   TELEGRAM_CHAT_ID   → message @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: path to SQLite database (defaults to ./lead_monitor.db)
# In Railway Docker: /app/data/lead_monitor.db (set in Dockerfile)
DB_PATH=
