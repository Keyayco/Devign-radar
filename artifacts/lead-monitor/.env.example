# Reddit Lead Intelligence Platform — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in values, OR set via dashboard Config tab.
#
# Telegram credentials are stored in monitor_config.json (set via dashboard).
# Only PORT and BASE_PATH are needed as env vars.

# Server port (default 3001)
PORT=3001

# URL prefix when behind a reverse proxy (e.g. /monitor or leave empty)
# Leave empty for standalone local use: node server.js
# Set to /monitor for Replit: BASE_PATH=/monitor node server.js
BASE_PATH=
